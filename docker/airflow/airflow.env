# Configuration NON secrète d'Airflow (versionnée dans Git).
# Les mots de passe et clés sont dans Secrets Manager (airflow/prod-latest).
AIRFLOW_UID=50000
POSTGRES_USER=airflow

# Synchronisation S3
S3_BUCKET=nappecast
DAGS_S3_PREFIX=airflow/dags
DATA_S3_PREFIX=airflow/data
LOGS_S3_PREFIX=airflow/logs
AWS_REGION=eu-west-3
AWS_DEFAULT_REGION=eu-west-3
SYNC_INTERVAL_SECONDS=60

# Serveur MLflow (IP privée de l'EC2 MLflow, joignable depuis l'EC2 Airflow)
MLFLOW_TRACKING_URI=http://172.31.32.79:5000
MLFLOW_EXPERIMENT_NAME=nappe-cast
