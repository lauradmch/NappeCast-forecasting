# Configuration NON secrète d'Airflow (versionnée dans Git).
# Les mots de passe et clés sont dans Secrets Manager (airflow/prod-latest).
AIRFLOW_UID=50000
POSTGRES_USER=airflow

# Synchronisation S3
S3_BUCKET=nappecast
DAGS_S3_PREFIX=airflow/dags
DATA_S3_PREFIX=airflow/data
LOGS_S3_PREFIX=airflow/logs
AWS_REGION=eu-west-3
AWS_DEFAULT_REGION=eu-west-3
SYNC_INTERVAL_SECONDS=60
