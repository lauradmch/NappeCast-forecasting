    "from statsmodels.tsa.forecasting.stl import STLForecast\n",
    "from statsmodels.tsa.arima.model import ARIMA\n",
    "\n",
    "# STLForecast: decomposes `series` with STL (period=365, same yearly\n",
    "# assumption as before), fits `model` only on the deseasonalized part\n",
    "# (trend + noise — no 365-parameter seasonal fit needed), then forecasts\n",
    "# and adds the seasonal component back in automatically.\n",
    "stlf = STLForecast(\n",
    "    series,\n",
    "    ARIMA, # ARIMA (AutoRegressive Integrated Moving Average) = statistical time series model\n",
    "    model_kwargs=dict(order=(1, 1, 1), trend=\"t\"),\n",
    "    period=365,\n",
    ")\n",
    "stlf_res = stlf.fit()\n",
    "\n",
    "y_pred = stlf_res.forecast(90)\n",
    "\n",
    "plt.figure(figsize=(14, 6))\n",
    "plt.plot(series, label=\"Observed groundwater level\")\n",
    "plt.plot(y_pred, label=\"Forecast (STL + ARIMA)\")\n",
    "plt.title(\"Groundwater level forecast (STL decomposition + ARIMA)\")\n",
    "plt.xlabel(\"Date\")\n",
    "plt.ylabel(\"Groundwater level (m)\")\n",
    "plt.legend()\n",
    "plt.show()"
   ]
