    "seasonal = result.seasonal # LOESS across cycle-subseries (all Januaries, all Februaries, etc.)\n",
    "noise = result.resid\n",
    "\n",
    "fig = result.plot()\n",
    "fig.set_size_inches(12, 8)\n",
    "plt.show()"
